# 第一阶段原生 JDBC 配置示例留档，不参与 SSM 编译。
# 复制为 db.properties 后填写本机配置；db.properties 已被 .gitignore 忽略。
jdbc.driver=com.mysql.cj.jdbc.Driver
jdbc.url=jdbc:mysql://127.0.0.1:3306/taskmaster?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
jdbc.username=taskmaster_app
jdbc.password=请填写数据库密码
