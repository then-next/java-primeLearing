<%
    // 静态包含片段：依赖调用页声明的 task、errors 变量。
    String titleError = errors.get("title");
    String descriptionError = errors.get("description");
    String statusError = errors.get("status");
    String priorityError = errors.get("priority");
    String dueDateError = errors.get("dueDate");
%>
<div class="form-grid">
    <label class="field field-wide">
        <span>任务标题 <em>*</em></span>
        <input type="text" name="title" maxlength="100" required
               value="<%= WebUtil.escapeHtml(task.getTitle()) %>"
               placeholder="例如：完成 Servlet 实验报告">
        <% if (titleError != null) { %><small class="field-error"><%= WebUtil.escapeHtml(titleError) %></small><% } %>
    </label>

    <label class="field field-wide">
        <span>任务描述</span>
        <textarea name="description" maxlength="1000" rows="6"
                  placeholder="补充背景、验收标准或下一步动作"><%= WebUtil.escapeHtml(task.getDescription()) %></textarea>
        <% if (descriptionError != null) { %><small class="field-error"><%= WebUtil.escapeHtml(descriptionError) %></small><% } %>
    </label>

    <label class="field">
        <span>状态</span>
        <select name="status">
            <option value="0" <%= task.getStatus() == 0 ? "selected" : "" %>>待办</option>
            <option value="1" <%= task.getStatus() == 1 ? "selected" : "" %>>进行中</option>
            <option value="2" <%= task.getStatus() == 2 ? "selected" : "" %>>已完成</option>
        </select>
        <% if (statusError != null) { %><small class="field-error"><%= WebUtil.escapeHtml(statusError) %></small><% } %>
    </label>

    <label class="field">
        <span>优先级</span>
        <select name="priority">
            <option value="1" <%= task.getPriority() == 1 ? "selected" : "" %>>高</option>
            <option value="2" <%= task.getPriority() == 2 ? "selected" : "" %>>中</option>
            <option value="3" <%= task.getPriority() == 3 ? "selected" : "" %>>低</option>
        </select>
        <% if (priorityError != null) { %><small class="field-error"><%= WebUtil.escapeHtml(priorityError) %></small><% } %>
    </label>

    <label class="field">
        <span>截止日期</span>
        <input type="date" name="dueDate"
               value="<%= task.getDueDate() == null ? "" : task.getDueDate() %>">
        <% if (dueDateError != null) { %><small class="field-error"><%= WebUtil.escapeHtml(dueDateError) %></small><% } %>
    </label>
</div>
